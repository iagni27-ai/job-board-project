# Salin file ini menjadi .env.local lalu isi nilainya. JANGAN commit .env.local.

# Kunci penanda tangan sesi (wajib, minimal 32 karakter acak).
# Buat dengan: openssl rand -base64 48
SESSION_SECRET=

# Akun admin untuk pengembangan lokal (opsional, diabaikan di production).
# Dipakai oleh user store sementara; akan diganti seeder database.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
